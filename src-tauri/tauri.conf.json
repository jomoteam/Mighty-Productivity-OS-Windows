{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mighty-Productivity-OS-Windows",
  "version": "0.4.0",
  "identifier": "com.jomoteam.mightyproductivityoswindows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mighty-Productivity-OS-Windows v0.4.0",
        "width": 560,
        "height": 660,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "url": "/"
      },
      {
        "label": "indicator",
        "title": "Dictation Indicator",
        "width": 200,
        "height": 44,
        "x": -500,
        "y": -500,
        "url": "/#/indicator",
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "screenshot_overlay",
        "title": "Mighty Screenshot",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "url": "/#/screenshot-overlay",
        "transparent": true,
        "shadow": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": false,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "./Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
